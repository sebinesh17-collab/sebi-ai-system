# SEBI Environment Configuration

# Core Settings
SEBI_ENV=development
SEBI_DEBUG=true
SEBI_LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Model Configuration
MODEL_NAME=mistral-7b-instruct
MODEL_PATH=./models
MODEL_DEVICE=cuda
MODEL_PRECISION=float16
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0.7

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Database Configuration
DATABASE_URL=postgresql://sebi:sebi_password@localhost:5432/sebi_db
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_PATH=./storage
KNOWLEDGE_INDEX_PATH=./storage/knowledge_index
DATASET_PATH=./storage/datasets
MODEL_REGISTRY_PATH=./storage/models
TEMPORARY_MEDIA_RETENTION_MINUTES=5

# Knowledge & Retrieval
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Web Search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10

# External AI Providers
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# Training Configuration
TRAINING_ENABLED=true
TRAINING_BATCH_SIZE=8
TRAINING_LEARNING_RATE=2e-5
TRAINING_EPOCHS=3
TRAINING_MAX_GRAD_NORM=1.0
TRAINING_WARMUP_STEPS=500
TRAINING_EVAL_STEPS=500

# Dataset Quality Gates
QUALITY_MIN_LENGTH=10
QUALITY_MAX_LENGTH=4096
QUALITY_DUPLICATE_THRESHOLD=0.95
QUALITY_TOXICITY_THRESHOLD=0.7
QUALITY_HALLUCINATION_THRESHOLD=0.6

# Security
SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HEADER=X-SEBI-API-Key

# Audit & Monitoring
AUDIT_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log
METRICS_ENABLED=true
OBSERVABILITY_ENABLED=true

# File Ingestion
FILE_INGESTION_ENABLED=true
FILE_WATCH_DIRECTORY=./input_files
SUPPORTED_FILE_TYPES=txt,md,json,pdf,docx,py,js,ts,yaml,yml
MAX_FILE_SIZE_MB=100

# Reasoning Effort
REASONING_EFFORT=medium
# Options: fast, low, medium, high, max

# Memory Configuration
SHORT_TERM_MEMORY_SIZE=100
LONG_TERM_MEMORY_ENABLED=true
PROJECT_MEMORY_ENABLED=true

# Tool Execution
TOOL_TIMEOUT_SECONDS=30
TOOL_EXECUTION_LIMIT=50
TOOL_SANDBOX_ENABLED=true
